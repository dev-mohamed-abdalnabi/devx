<?xml version="1.0" encoding="utf-8"?>
<!--
  كارت الرئيسية بطبقات: ثابت + نجوم (تبادل بطيء بتلاشي = لمعان) + سحاب/طيور (لوحان يمرّان بحركة خطية متصلة)
  + نص ثابت فوقها. الحركة كلها داخل اللانشر وتتوقف تلقائيًا عند إطفاء الشاشة.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/azw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/azw_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ViewFlipper
        android:id="@+id/azw_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="3200"
        android:inAnimation="@anim/azw_fade_in"
        android:outAnimation="@anim/azw_fade_out"
        android:visibility="gone">

        <ImageView
            android:id="@+id/azw_s0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/azw_s1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </ViewFlipper>

    <ViewFlipper
        android:id="@+id/azw_move"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="26000"
        android:inAnimation="@anim/azw_pan_in"
        android:outAnimation="@anim/azw_pan_out"
        android:visibility="gone">

        <ImageView
            android:id="@+id/azw_m0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/azw_m1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </ViewFlipper>

    <ImageView
        android:id="@+id/azw_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</FrameLayout>
