<?xml version="1.0" encoding="utf-8"?>
<!-- كارت الرئيسية: طبقة أساس + تبديل إطارات بتلاشي (حركة النجوم والسحاب) + طبقة النص الثابتة فوقها. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/azw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/azw_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ViewFlipper
        android:id="@+id/azw_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="5000"
        android:inAnimation="@anim/azw_fade_in"
        android:outAnimation="@anim/azw_fade_out">

        <ImageView
            android:id="@+id/azw_f0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/azw_f1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/azw_f2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </ViewFlipper>

    <ImageView
        android:id="@+id/azw_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</FrameLayout>
